<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="ARIA"
        android:icon="@drawable/aria_launcher"
        android:roundIcon="@drawable/aria_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Existing native activity is retained so its code is not deleted. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AriaNotificationJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Keep the established native app as the launcher. The experimental
             WebView shell must not replace the working main app until verified. -->
        <activity
            android:name=".AriaGlassActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize" />
    </application>
</manifest>
