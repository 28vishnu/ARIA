<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="ARIA"
        android:icon="@drawable/aria_launcher"
        android:roundIcon="@drawable/aria_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Launch the glass UI, which contains the current chat, voice and inbox features. -->
        <activity
            android:name=".AriaGlassActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Retain the legacy native screen for compatibility and diagnostics. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <service
            android:name=".AriaNotificationJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

    </application>
</manifest>
