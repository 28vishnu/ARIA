# JARVIS product/runtime identity
JARVIS_ENVIRONMENT=production
JARVIS_VECTOR_PERSIST_PATH=./aria_vectors
JARVIS_TIMEOUT=15.0
JARVIS_PERMISSION_MODE=autonomous

# Retained legacy aliases for existing deployments
# AR_ENVIRONMENT=production
# RENDER_PERSISTENT_DIR=./aria_vectors
# AR_TIMEOUT=15.0
# AR_PERMISSION_MODE=autonomous

# Core services (set only when using the corresponding integrations)
MONGODB_URI=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=
TELEGRAM_TOKEN=
OPENALEX_API_KEY=

# Telegram owner access (webhook)
ALLOWED_TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Telegram alert delivery (optional; legacy alias TELEGRAM_CHAT_ID is also read)
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
TELEGRAM_CHAT_ID=

# GitHub webhook verification and account actions
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Google read-only OAuth (Gmail / Calendar / Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_DRIVE_REDIRECT_URI=
ARIA_GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional runtime overrides (defaults shown in core/configuration.py)
LOG_LEVEL=INFO
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=

# NVIDIA NIM (disabled by default; requires explicit opt-in)
ARIA_STRICT_NO_LLM=1
ARIA_ALLOW_CLOUD_LLM=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Local storage paths and limits (defaults apply when unset)
ARIA_ALERT_DB_PATH=
ARIA_WORKSPACE_DB_PATH=
ARIA_MAX_UPLOAD_BYTES=

# Owner app authentication; use a long random signing secret (32+ characters)
ARIA_OWNER_TELEGRAM_ID=
ARIA_OWNER_APP_SECRET=
ARIA_APP_TOKEN_SECRET=
